# Copy to .env.app.local. This origin is compiled into the native client, not a secret.
# App connects directly; XIM_BACKEND_URL and VITE_WS_URL only configure Web.
XIM_APP_SERVER_URL=https://chat.example.com
# Local HTTP validation only, with backend -Dxim.web.cookieSecure=false:
# XIM_APP_SERVER_URL=http://127.0.0.1:8080
# XIM_APP_ALLOW_HTTP=1
