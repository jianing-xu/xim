{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XIM",
  "version": "1.0.0",
  "identifier": "cn.xjn.xim",
  "build": {
    "beforeDevCommand": "npm run dev:app",
    "beforeBuildCommand": "npm run build:app",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist-app"
  },
  "app": {
    "windows": [{ "label": "main", "title": "XIM", "width": 1280, "height": 860, "minWidth": 360, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "XIM 即时通讯客户端",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
