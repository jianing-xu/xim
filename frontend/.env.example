# Development/preview proxy target (only read by Vite, not exposed to the browser).
XIM_BACKEND_URL=http://127.0.0.1:8080
# Optional SAME-SITE direct URL; configure xim.web.allowedOrigins.
# With localhost frontend, use localhost backend (not 127.0.0.1).
# Local HTTP development also requires -Dxim.web.cookieSecure=false.
# Prefer the same-origin /ws and /api proxy above.
# VITE_WS_URL=ws://localhost:8080/ws
