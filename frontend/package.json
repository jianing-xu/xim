{
  "name": "xim-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "e2e:prepare": "npm run build && mvn -f ../backend/pom.xml package -DskipTests dependency:copy-dependencies -DincludeScope=runtime -DoutputDirectory=target/release/lib && node ../scripts/package-backend.mjs",
    "proto:generate": "pbjs -t static-module -w es6 --force-long --no-service -o src/generated/xim.js ../protocol/xim.proto && pbts -o src/generated/xim.d.ts src/generated/xim.js",
    "prebuild": "npm run proto:generate",
    "pretest": "npm run proto:generate",
    "pretypecheck": "npm run proto:generate",
    "predev": "npm run proto:generate",
    "pretest:e2e": "npm run proto:generate",
    "tauri": "tauri",
    "app:dev": "node scripts/app.mjs desktop dev",
    "app:build": "node scripts/app.mjs desktop build",
    "app:macos": "node scripts/app.mjs macos build",
    "app:windows": "node scripts/app.mjs windows build",
    "app:android:init": "node scripts/app.mjs android init",
    "app:android:dev": "node scripts/app.mjs android dev",
    "app:android": "node scripts/app.mjs android build",
    "app:ios:init": "node scripts/app.mjs ios init",
    "app:ios:dev": "node scripts/app.mjs ios dev",
    "app:ios": "node scripts/app.mjs ios build",
    "dev:app": "npm run proto:generate && vite --mode app",
    "build:app": "npm run proto:generate && tsc --noEmit && vite build --mode app",
    "app:icons": "tauri icon public/icon.png",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "long": "5.3.2",
    "protobufjs": "8.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "protobufjs-cli": "2.7.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
