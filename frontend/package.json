{
  "name": "xim-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "e2e:prepare": "npm run build && mvn -f ../backend/pom.xml compile dependency:build-classpath -Dmdep.outputFile=target/classpath.txt"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
