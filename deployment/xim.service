[Unit]
Description=XIM single-instance backend
After=network.target
[Service]
Type=simple
User=xim
Group=xim
WorkingDirectory=/var/lib/xim
EnvironmentFile=/etc/xim/xim.env
ExecStart=/opt/xim/deployment/start-backend.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xim
LimitNOFILE=4096
[Install]
WantedBy=multi-user.target
